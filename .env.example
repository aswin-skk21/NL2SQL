# Copy to .env at the repo root and fill in. Never commit the real .env.

# Google API key with Gemini access.
GOOGLE_API_KEY=your-gemini-key-here

# Shared token every client must send as "Authorization: Bearer <token>".
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
NL2SQL_API_TOKEN=generate-me

# --- optional tuning -------------------------------------------------------
# NL2SQL_HOST=0.0.0.0
# NL2SQL_PORT=8000
# NL2SQL_CONNECT_TIMEOUT=10
# NL2SQL_QUERY_TIMEOUT=60
# NL2SQL_MAX_ROWS=5000

# Only needed if the UI is hosted on a different origin than the API.
# NL2SQL_CORS_ORIGINS=http://nl2sql.internal.example.com

# Set to 1 to return exception detail to the browser. Leave unset in production.
# NL2SQL_DEBUG_ERRORS=0
